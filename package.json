{
  "name": "thinkube-cicd-monitor",
  "displayName": "Thinkube CI/CD Monitor",
  "description": "Thinkube CI/CD pipelines, Mill runs and Forge runs, with their logs and training loss, directly in VS Code",
  "version": "0.1.4",
  "publisher": "thinkube",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "ci/cd",
    "pipeline",
    "monitoring",
    "thinkube",
    "kubernetes"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkube/thinkube-cicd-monitor"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "thinkube-cicd",
          "title": "Thinkube CI/CD",
          "icon": "media/tk_devops.svg"
        }
      ]
    },
    "views": {
      "thinkube-cicd": [
        {
          "id": "thinkube-cicd.pipelines",
          "name": "Pipelines",
          "icon": "media/tk_devops.svg",
          "contextualTitle": "CI/CD Pipelines"
        },
        {
          "id": "thinkube-cicd.millRuns",
          "name": "Mill Runs",
          "icon": "media/tk_devops.svg",
          "contextualTitle": "Mill Runs"
        },
        {
          "id": "thinkube-cicd.forgeRuns",
          "name": "Forge Runs",
          "icon": "media/tk_devops.svg",
          "contextualTitle": "Forge Runs"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "thinkube-cicd.pipelines",
        "contents": "No pipelines running.\n[Refresh](command:thinkube-cicd.refreshPipelines)"
      }
    ],
    "commands": [
      {
        "command": "thinkube-cicd.showPipeline",
        "title": "Show Pipeline Details",
        "category": "Thinkube CI/CD"
      },
      {
        "command": "thinkube-cicd.refreshPipelines",
        "title": "Refresh Pipelines",
        "category": "Thinkube CI/CD",
        "icon": "$(refresh)"
      },
      {
        "command": "thinkube-cicd.showTimeline",
        "title": "Show Pipeline Timeline",
        "category": "Thinkube CI/CD"
      },
      {
        "command": "thinkube-cicd.viewLogs",
        "title": "View Step Logs",
        "category": "Thinkube CI/CD",
        "icon": "$(output)"
      },
      {
        "command": "thinkube-cicd.configureToken",
        "title": "Configure API Token",
        "category": "Thinkube CI/CD",
        "icon": "$(key)"
      },
      {
        "command": "thinkube-cicd.refreshMillRuns",
        "title": "Refresh Mill Runs",
        "category": "Thinkube CI/CD",
        "icon": "$(refresh)"
      },
      {
        "command": "thinkube-cicd.viewMillRunLog",
        "title": "View Run Log",
        "category": "Thinkube CI/CD",
        "icon": "$(output)"
      },
      {
        "command": "thinkube-cicd.openMillRun",
        "title": "Open in Thinkube Control",
        "category": "Thinkube CI/CD",
        "icon": "$(link-external)"
      },
      {
        "command": "thinkube-cicd.refreshForgeRuns",
        "title": "Refresh Forge Runs",
        "category": "Thinkube CI/CD",
        "icon": "$(refresh)"
      },
      {
        "command": "thinkube-cicd.showForgeRun",
        "title": "Show Forge Run",
        "category": "Thinkube CI/CD",
        "icon": "$(graph-line)"
      },
      {
        "command": "thinkube-cicd.openForgeRun",
        "title": "Open in Thinkube Control",
        "category": "Thinkube CI/CD",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "thinkube-cicd.refreshPipelines",
          "when": "view == thinkube-cicd.pipelines",
          "group": "navigation"
        },
        {
          "command": "thinkube-cicd.refreshMillRuns",
          "when": "view == thinkube-cicd.millRuns",
          "group": "navigation"
        },
        {
          "command": "thinkube-cicd.refreshForgeRuns",
          "when": "view == thinkube-cicd.forgeRuns",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "thinkube-cicd.showPipeline",
          "when": "view == thinkube-cicd.pipelines && viewItem == pipeline",
          "group": "inline"
        },
        {
          "command": "thinkube-cicd.showTimeline",
          "when": "view == thinkube-cicd.pipelines && viewItem == pipeline",
          "group": "navigation"
        },
        {
          "command": "thinkube-cicd.viewLogs",
          "when": "view == thinkube-cicd.pipelines && viewItem == stage",
          "group": "inline"
        },
        {
          "command": "thinkube-cicd.viewMillRunLog",
          "when": "view == thinkube-cicd.millRuns && viewItem == millRun",
          "group": "inline"
        },
        {
          "command": "thinkube-cicd.openMillRun",
          "when": "view == thinkube-cicd.millRuns && viewItem == millRun",
          "group": "inline"
        },
        {
          "command": "thinkube-cicd.showForgeRun",
          "when": "view == thinkube-cicd.forgeRuns && viewItem == forgeRun",
          "group": "inline"
        },
        {
          "command": "thinkube-cicd.openForgeRun",
          "when": "view == thinkube-cicd.forgeRuns && viewItem == forgeRun",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "thinkube-cicd.viewMillRunLog",
          "when": "false"
        },
        {
          "command": "thinkube-cicd.openMillRun",
          "when": "false"
        },
        {
          "command": "thinkube-cicd.showForgeRun",
          "when": "false"
        },
        {
          "command": "thinkube-cicd.openForgeRun",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Thinkube CI/CD Monitor",
      "properties": {
        "thinkube-cicd.apiUrl": {
          "type": "string",
          "description": "Address of thinkube-control, for example https://control.example.com. Required. Thinkube sets it in code-server."
        },
        "thinkube-cicd.refreshInterval": {
          "type": "number",
          "default": 30000,
          "minimum": 10000,
          "description": "Refresh interval in milliseconds (at least 10000: every open window polls Thinkube Control)"
        },
        "thinkube-cicd.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications for pipeline events"
        },
        "thinkube-cicd.notificationLevel": {
          "type": "string",
          "enum": [
            "all",
            "failures",
            "none"
          ],
          "default": "all",
          "description": "Pipeline completion notifications: all (success + failure + cancelled), failures (only failures), none (disabled)"
        },
        "thinkube-cicd.apiToken": {
          "type": "string",
          "default": "",
          "description": "API token for authentication (optional). Get it from the Tokens page of thinkube-control"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish:ovsx": "ovsx publish",
    "prepublish:ovsx": "npm run compile && npm run package",
    "deploy": "scripts/deploy.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.3.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
